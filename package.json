{
  "name": "boiler-snake",
  "version": "1.12.0",
  "license": "MIT",
  "description": "Boiler Snake: XP + leveling + roles with per-guild settings.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/commands/register.js",
    "ensure-role": "node scripts/ensure-role.js",
    "test": "node --test test/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-exclude='node_modules/**' --test-coverage-lines=77 --test-coverage-branches=67 --test-coverage-functions=77 test/*.test.js test/integration/*.test.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "//": "test:coverage = Node's built-in runner coverage (no deps) over src/ for BOTH suites in one run; include/exclude keep src/ only in the report. Threshold flags check OVERALL totals (node exits 1 when unmet). They baseline-lock the 2026-09-09 actuals (all files: lines 79.99%, branches 69.57%, funcs 79.72%) at ~3pts below: 77/67/77. Team targets are critical-paths 100% / high 90%+ (standards) — raise thresholds as coverage improves; never lower the gate to accommodate a regression.",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^0.1.67",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "jsdom": "^30.0.1",
    "lavalink-client": "^2.11.0",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metalsp0rk/boiler-snake.git"
  },
  "bugs": {
    "url": "https://github.com/metalsp0rk/boiler-snake/issues"
  },
  "homepage": "https://github.com/metalsp0rk/boiler-snake#readme",
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "better-sqlite3@12.11.1": true
  }
}
