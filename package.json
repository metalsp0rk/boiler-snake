{
  "name": "boiler-snake",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Boiler Snake: XP + leveling + roles with per-guild settings.",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/commands/register.js",
    "ensure-role": "node scripts/ensure-role.js",
    "test": "node --test test/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.67",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metalsp0rk/boiler-snake.git"
  },
  "bugs": {
    "url": "https://github.com/metalsp0rk/boiler-snake/issues"
  },
  "homepage": "https://github.com/metalsp0rk/boiler-snake#readme",
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "better-sqlite3@12.11.1": true
  }
}
