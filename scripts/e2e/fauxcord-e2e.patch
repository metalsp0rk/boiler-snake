+/** Adds the E2E-fidelity columns to messages/interactions when missing. */
+function migrateE2eFidelityColumns(db: Database): void {
+  for (const [table, cols] of [
+    ['messages', MESSAGES_E2E_COLUMNS],
+    ['interactions', INTERACTIONS_E2E_COLUMNS],
+  ] as const) {
+    const existing = new Set(
