+    expect(snowflakeToTimestamp(oldMsg.id).getTime()).toBe(historicMs)
+
+    const fresh = await fetch(
+      `${server.baseUrl}/_test/channels/${channelId}/messages`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
