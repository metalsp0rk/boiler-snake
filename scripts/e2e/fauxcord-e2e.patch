+/**
+ * SPIKE PATCH (boiler-snake e2e): persist multipart files onto an existing
+ * message, mirroring discord.js' `payload_json.attachments` contract:
+ *   - entries whose id names an existing attachment row are KEPT;
+ *   - remaining entries are NEW-file stubs (discord.js sends sequential ids
+ *     "0","1",...) paired positionally with the files[N] parts;
+ *   - replace=true (message EDIT semantics) deletes existing rows the list
+ *     omits — an edit not listing an attachment removes it, like real
+ *     Discord. With no list at all, files simply append to the message.
+ * ENOENT from a missing upload dir is tolerated (in-memory test envs);
+ * anything else surfaces (channel-messages.ts POST precedent).
+ */
+export async function applyIncomingAttachments(
+  db: Database,
+  uploadPath: string,
+  baseUrl: string,
+  channelId: string,
+  messageId: string,
+  files: UploadedFile[],
+  attachmentsList?: unknown[],
+  opts: { replace?: boolean } = {}
+): Promise<void> {
+  const rows = db
+    .prepare('SELECT id FROM attachments WHERE message_id = ?')
+    .all(messageId) as { id: string }[]
+  const existingIds = new Set(rows.map((r) => r.id))
+
+  if (Array.isArray(attachmentsList)) {
+    const entries = attachmentsList.filter(
+      (a): a is { id?: unknown; filename?: unknown } =>
+        a !== null && typeof a === 'object'
+    )
+    const listedExisting = new Set(
+      entries
+        .map((e) => String(e.id ?? ''))
+        .filter((id) => existingIds.has(id))
+    )
+    if (opts.replace) {
+      for (const id of existingIds) {
+        if (!listedExisting.has(id)) {
+          db.prepare('DELETE FROM attachments WHERE message_id = ? AND id = ?').run(
+            messageId,
+            id
+          )
+        }
+      }
+    }
+  }
+
+  for (let i = 0; i < files.length; i++) {
+    const f = files[i]
+    const filename =
+      f.name ||
+      (typeof attachmentsList?.[i] === 'object' &&
+      attachmentsList[i] !== null &&
+      typeof (attachmentsList[i] as { filename?: unknown }).filename === 'string'
+        ? String((attachmentsList[i] as { filename: string }).filename)
+        : `attachment-${i}`)
