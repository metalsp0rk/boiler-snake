+const INTERACTIONS_E2E_COLUMNS: Record<string, string> = {
+  message_id: 'TEXT',
+  response_json: 'TEXT',
+}
+
+/** Adds the E2E-fidelity columns to messages/interactions when missing. */
+function migrateE2eFidelityColumns(db: Database): void {
+  for (const [table, cols] of [
+    ['messages', MESSAGES_E2E_COLUMNS],
+    ['interactions', INTERACTIONS_E2E_COLUMNS],
+  ] as const) {
+    const existing = new Set(
+      (db.prepare(`PRAGMA table_info(${table})`).all() as { name: string }[]).map(
+        (col) => col.name
+      )
+    )
+    for (const [name, ddl] of Object.entries(cols)) {
+      if (!existing.has(name)) {
+        db.exec(`ALTER TABLE ${table} ADD COLUMN ${name} ${ddl}`)
+      }
+    }
+  }
+}
