# Required (unless FLUXER_INSTANCES supplies at least one endpoint): Discord
# bot token (Developer Portal -> Bot). Never commit a real token.
DISCORD_TOKEN=YOUR_BOT_TOKEN
# Optional for login, but WITHOUT it these stay dark: `npm run register`
# (slash commands), command-permission OAuth (/staff syncpermissions) and the
# web-admin Discord sign-in. Boot logs a `[config] WARN` when DISCORD_TOKEN is
# set and CLIENT_ID is not (audit #205) — the base bot still works.
CLIENT_ID=YOUR_APP_CLIENT_ID

# Optional: Discord application client secret (OAuth for slash command visibility sync)
# Never commit a real secret. Required for /staff syncpermissions.
# CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Optional: set for fast dev-only registration (instant), otherwise commands register globally.
# DEV_GUILD_ID=YOUR_TEST_GUILD_ID

# E2E TESTING ONLY — never set in production. http(s) origin of a MOCK Discord
# (e.g. fauxcord at http://127.0.0.1:3100): redirects bot REST + gateway
# discovery (GET /gateway/bot) at the mock so no real Discord traffic happens;
# also disables gateway transport compression. See scripts/e2e/fauxcord-spike.js.
# DISCORD_API_BASE=http://127.0.0.1:3100

# Optional: feature-gate watchdog (audit C7). If no endpoint has armed the
# feature layer within this window, boot logs `[boot] watchdog ...` naming
# exactly what it is still waiting on (instead of zombie-booting silently).
# 0 disables the watchdog. Default: 120000 (ms).
# FEATURE_GATE_WATCHDOG_MS=120000
# Optional: cap on the feature gate holding a READY endpoint back for an
# UNSETTLED discord login (#392). After this window the gate opens DEGRADED:
# supervisor.discord reads as null (Fluxer-only view), Fluxer-tier features
# arm; a late ClientReady restores the client but skipped features need a
# restart. 0 = never force (wait forever, the heartbeat re-reports every
# watchdog window). Default: 0.
# FEATURE_GATE_MAX_HOLD_MS=0

# Optional: YouTube API key (for YouTube channel video notifications)
# YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Optional: music player (Lavalink 4.2+ sidecar — required for Discord voice audio)
# Compose sets LAVALINK_HOST=lavalink automatically. Local: 127.0.0.1
# Setting LAVALINK_HOST without LAVALINK_PASSWORD STOPS BOOT (fail-fast, audit
# #205): music would fail authorization at first play — a silent half-config.
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=YOUR_LAVALINK_PASSWORD
#   ^ REQUIRED for docker compose (#455, audit H2-7): this compose always runs
#     the lavalink sidecar, and compose ABORTS if LAVALINK_PASSWORD is unset —
#     the old `youshallnotpass` defaults made the #205 fail-fast unreachable.
# LAVALINK_SECURE=false
# Spotify Web API client credentials (catalog only — not audio streams)
# SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
# SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET

# Optional: Twitch app credentials (Client Credentials) for go-live notifications
# Register at https://dev.twitch.tv/console -> your app -> "Client Credentials"
# TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
# TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET

# Optional: Twitch EventSub webhooks (instant go-live/offline; polling stays
# as the fallback). All three required to enable; requires the public HTTP
# server exposed via HTTPS on port 443 (reverse proxy in front is fine).
# - SECRET: 10-100 chars, HMAC-signs deliveries; generate your own random value
# - CALLBACK_URL: optional; defaults to PUBLIC_BASE_URL + /hooks/twitch
# - MAX_CHANNELS: max broadcasters to subscribe (default 50, Twitch quota)
# TWITCH_EVENTSUB_SECRET=YOUR_RANDOM_EVENTSUB_SECRET
# TWITCH_EVENTSUB_CALLBACK_URL=https://bot.example.com/hooks/twitch
# TWITCH_EVENTSUB_MAX_CHANNELS=50

# Optional: SQLite location (default: project root). Docker compose sets DATA_DIR=/data
# DATA_DIR=/data
# Optional: full path override for the database file
# DB_PATH=/data/xpbot.sqlite

# Optional: process timezone for cron schedules (audit #206). Cron schedules —
# including the daily decay job below — evaluate in this timezone; docker
# compose defaults it to UTC so every deploy fires at the same instant.
# Node/libc read TZ themselves — src/ never reads it, hence the comment form.
# TZ=UTC

# Optional: schedule for the daily XP decay job (issue #282). 5-field cron
# evaluated in the process TZ above; unset = "0 4 * * *" (daily 04:00). A
# malformed expression STOPS BOOT and names the bad value. EU/AU audiences:
# e.g. `0 6 * * *` moves the sweep to 06:00. See docs/decay.md.
# DECAY_CRON=0 4 * * *

# Optional: data retention sweeps (audit #192). An hourly sweep (plus one at
# boot) prunes the growth-only tables in LIMIT-batched passes (500 rows x 40
# batches max per table per sweep — no writer-lockup). Each knob: days to
# keep; 0/off disables that table's sweep (rows kept forever). The web job
# health page lists the job as "retentionSweeps".
# XP/decay activity rows (decay windows are <=30d; 90 is a 3x margin):
# RETENTION_ACTIVITY_DAYS=90
# admin_audit IS the durable staff trail — one full annual cycle by default:
# RETENTION_ADMIN_AUDIT_DAYS=365
# Daily message aggregates — 400d keeps 13 months of monthly rollups:
# RETENTION_DAILY_AGGREGATES_DAYS=400
# Expired Fluxer login transactions die at their own expires_at (<=10 min
# old); 0/off freezes the sweep only for live debugging (the bounded
# lazy prune on transaction CREATE always runs):
# RETENTION_OAUTH_TX_SWEEP=1
# Settled bridge relay-audit rows (done/failed outbox rows; live queue rows
# are never swept, parked rows stay /bridge-retryable for this window):
# RETENTION_BRIDGE_OUTBOX_DAYS=30
# Source→destination part map (#399). Past this age a LATER edit of an old
# relayed message re-sends its part as fresh — 0/off keeps every link:
# RETENTION_BRIDGE_LINKS_DAYS=90
# Per-event audit feed rows (#399; events archive, never auto-delete):
# RETENTION_EVENT_ACTIVITY_DAYS=90
# Settled reminder rows only (sent/retired, N days past fire time; pending
# and backoff rows are never swept) (#399):
# RETENTION_EVENT_NOTIFICATIONS_DAYS=90
# Orphan ticket-archive directories (crashed archive left a {uuid}/ dir with
# no tickets row): removed past this age. Referenced transcripts stay
# forever; 0/off keeps every directory (#424):
# RETENTION_TICKET_TRANSCRIPT_ORPHAN_DAYS=7

# Optional: public HTTP (ticket HTML transcripts + command-permission OAuth callback)
# TICKET_HTTP_PORT and TICKET_PUBLIC_BASE_URL still work; PUBLIC_* are aliases.
# PUBLIC_HTTP_PORT=8080
# PUBLIC_BASE_URL=https://bot.example.com
# TICKET_HTTP_PORT=8080
# TICKET_PUBLIC_BASE_URL=https://bot.example.com
# OAuth2 redirect in Developer Portal must match exactly, e.g.:
#   https://bot.example.com/oauth/command-permissions/callback
# Or set explicitly:
# OAUTH_REDIRECT_URI=https://bot.example.com/oauth/command-permissions/callback
# Google Calendar for /event google (community events phase 5). Create an
# OAuth client (type: Web) in Google Cloud Console, add the redirect URI
# below to its allowed list. Without these the calendar features report
# "not configured" and everything else keeps working.
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Optional explicit override; default = PUBLIC_BASE_URL + /oauth/gcal/callback
# GOOGLE_REDIRECT_URI=https://bot.example.com/oauth/gcal/callback
# Dedicated HMAC secret for OAuth state signing (command-permissions + web
# login flows). RECOMMENDED: unset falls back to the shared CLIENT_SECRET and
# boot logs a `[config] WARN` (audit #205 — key-domain coupling: rotating the
# Discord app secret would also invalidate in-flight OAuth states). Required
# explicitly on Fluxer-only installs (no CLIENT_SECRET exists to fall back to).
# OAUTH_STATE_SECRET=YOUR_RANDOM_SECRET  (e.g. openssl rand -hex 32)
# TICKET_MAX_ASSET_BYTES=52428800
# TICKET_MAX_ASSETS=100
# Aggregate budget for the whole ticket-transcripts tree (all communities);
# an archive whose media would cross it skips the media with a warning
# instead of filling the DB volume. 0/off = unlimited (#424):
# TICKET_ASSET_TREE_MAX_BYTES=2147483648

# At-rest encryption for THIRD-PARTY tokens (audit C6): GitHub PATs stored by
# /github watch and the Discord user OAuth tokens behind /staff
# syncpermissions are AES-256-GCM envelope-encrypted in SQLite with this key
# (32 bytes of base64: openssl rand -base64 32). Required whenever those
# features store a token; on first boot of this version the one-time
# migration also NEEDS it if any such rows already exist (it refuses to boot
# with half-encrypted columns rather than storing plaintext). No key rotation
# in v1 — changing it strands existing stored tokens (re-add watches,
# re-authorize sync). Distinct from BRIDGE_TOKEN_KEY on purpose.
# TOKEN_ENCRYPTION_KEY=YOUR_RANDOM_32_BYTE_BASE64_KEY

# Web admin console (roadmap/web-admin.md §8.10). Dark by default: nothing
# listens unless PUBLIC_HTTP_PORT above is set. Register the Discord OAuth
# redirect {PUBLIC_BASE_URL}/auth/login/callback in the Developer Portal.
# Signs session cookies; defaults to CLIENT_SECRET with a boot warning.
# SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET
# Session lifetime in hours (default 12, absolute cap 168 = 7 days).
# WEB_SESSION_TTL_HOURS=12
# Tier-cache TTL in ms (default 60000) — bounds role-revocation lag to ≤60 s.
# WEB_TIER_CACHE_TTL_MS=60000
# Reverse-proxy trust: honor X-Forwarded-For ONLY when set (behind
# nginx/traefik etc. set 1; default off → the socket address is the client
# identity, which fails safe for an unconfigured proxy).
# WEB_TRUST_PROXY=1
# Max accepted request body in bytes; 413 beyond it (default 65536).
# WEB_MAX_BODY_BYTES=65536
# Fixed-window rate limits (all share the window length). Defaults shown:
# login+OAuth per client IP / per resolved user; mutations per user.
# WEB_RATE_LIMIT_WINDOW_MS=60000
# WEB_RATE_LIMIT_AUTH_MAX=30
# WEB_RATE_LIMIT_AUTH_USER_MAX=10
# WEB_RATE_LIMIT_MUTATION_MAX=120
# Dashboard snapshot cache TTL in ms (default 30000; values below the 30 s
# floor are clamped up with a warning).
# WEB_DASHBOARD_CACHE_TTL_MS=30000
# Discord OAuth prompt param for the web sign-in: consent (default, fresh
# consent screen) or none (silent re-auth). Anything else uses consent.
# WEB_LOGIN_PROMPT=consent
# Explicit override for the web-login redirect URI; default is
# {PUBLIC_BASE_URL}/auth/login/callback (must match the Developer Portal).
# WEB_LOGIN_REDIRECT_URI=https://bot.example.com/auth/login/callback

# Optional: AI provider (OpenAI-compatible) — ticket close summaries + Gork Q&A
# AI_API_KEY=YOUR_AI_API_KEY
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Optional: smaller model for the gork memory extraction turn; defaults to AI_MODEL
# AI_SMALL_MODEL=
# Legacy fallback aliases (audit #205 parity sweep): when the matching AI_*
# var is UNSET, the OPENAI_* one is used instead. AI_* always wins; prefer
# AI_* on new deploys.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Deadline for the ticket-archive AI summary turn (ms, default 20000;
# re-read per call). On timeout the archive completes with the stats
# fallback summary and a warning naming the deadline (audit #197).
# TICKET_SUMMARY_TIMEOUT_MS=20000

# Optional: Gork web search — base URL of a SearXNG instance with JSON format enabled
# SEARXNG_URL=https://searxng.example.com

# Optional: Gork LLM budget overrides (defaults shown). Raise
# GORK_LLM_TIMEOUT_MS for slow local models; thinking/reasoning models
# spend GORK_LLM_MAX_TOKENS on hidden reasoning before the visible answer.
# GORK_LLM_MAX_TOKENS=6000
# GORK_LLM_TIMEOUT_MS=90000
# GORK_LLM_MAX_TOOL_ROUNDS=3
# Cap hidden reasoning tokens on thinking-model servers that enforce it
# (e.g. vLLM started with --reasoning-parser): the model must stop
# thinking and answer once the cap is hit. 0/unset = param not sent
# (required for strict providers like api.openai.com).
# GORK_LLM_THINKING_TOKEN_BUDGET=4000
# Memory extraction turn deadline (default 20000). Thinking models used
# for extraction (AI_SMALL_MODEL unset → AI_MODEL) routinely need more.
# GORK_MEMORY_TURN_TIMEOUT_MS=20000
# Hard cap for the visible answer in chars (0 = off). Word-boundary
# truncate + "[truncated]" marker; 2000 keeps any answer to one message.
# GORK_MAX_ANSWER_CHARS=0
# Deadline for the /gork summarize one-shot generation turn (ms, default
# 900000 = 15 minutes; re-read per job). On timeout the command reports the
# deadline naming it — nothing is posted and no budget is spent.
# GORK_SUMMARIZE_TURN_TIMEOUT_MS=900000

# Optional: Gork debug tracing. 1 = log a "[gork] dbg ..." line per job
# phase (dequeue, context, roster, LLM call, reply) with cumulative job
# timing, so a fast failure shows WHERE the job died. Re-read per job —
# no restart needed. Unset/0 = off.
# GORK_DEBUG=1

# Optional: Gork interaction log (docs/gork-logging.md) — per-job DB
# transcripts (prompt, tool calls, answer). ON by default: rows contain
# conversation content, so this is a privacy knob, not just debugging.
# 0 = process-wide kill-switch (nothing captured; answers unaffected;
# beats the per-guild setting). Re-read per job — no restart needed.
# GORK_INTERACTION_LOG=1
# Days to keep rows; pruned lazily on insert (default 30; 0 = keep forever).
# GORK_INTERACTION_LOG_RETENTION_DAYS=30
# Transcript JSON budget per row in chars (default 200000; oldest events are
# dropped with a truncation marker to stay under it).
# GORK_INTERACTION_LOG_MAX_JSON_CHARS=200000

# Optional: Gork vision (issue #227) — image attachments on the trigger /
# context messages are downloaded, downscaled to fit a 1280×1280 box
# (aspect kept, never upscaled) and sent as multimodal image parts. All
# knobs are re-read per job. Requires a VISION-capable model (AI_MODEL —
# e.g. gpt-4o-mini; set GORK_VISION_MODEL when a text-only default model
# should keep answering text-only questions).
# Max images per LLM request; 0 = vision fully disabled.
# GORK_VISION_MAX_IMAGES=4
# Optional model override applied ONLY to requests that carry images.
# GORK_VISION_MODEL=
# Per-attachment download ceiling / total image bytes per request.
# GORK_VISION_MAX_IMAGE_BYTES=15728640
# GORK_VISION_MAX_TOTAL_BYTES=12582912
# Per-image download timeout (ms).
# GORK_VISION_DOWNLOAD_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Fluxer Phase 0 spike (roadmap/fluxer.md, PR 1) — consumed ONLY by the
# manual `npm run fluxer:spike` script; never read by the bot at runtime.
# Token: Fluxer user settings -> Apps -> New Application -> Bot.
# Prefer FLUXER_SPIKE_TOKEN_FILE pointing at a file OUTSIDE the repo.
# FLUXER_SPIKE_URL=https://chat.example.com
# FLUXER_SPIKE_TOKEN_FILE=/secure/path/fluxer-bot-token
# FLUXER_SPIKE_GUILD=<test community id>
# FLUXER_SPIKE_CHANNEL=<text channel id, optional — auto-picked if unset>
# FLUXER_SPIKE_TEST_USER=<user id for DM + member-fetch checks, optional>
# FLUXER_SPIKE_BAN_USER=<sacrificial user id for ban/unban check, optional>
#
# Fluxer Bridge Phase 0 spike (roadmap/bridge.md §10.14, PR 1) — additionally
# consumed by the manual `npm run fluxer:bridge-spike` script (probes B1-B14).
# FLUXER_SPIKE_WEBHOOK_CHANNEL=<text channel id where the spike creates + deletes its probe webhook>
# FLUXER_SPIKE_NSFW_CHANNEL=<age-restricted channel id for probe B9, optional — skipped if unset>

# ---------------------------------------------------------------------------
# Channel bridges (roadmap/bridge.md, PRs 1-8) — read by the bot at runtime.
# Docs: docs/bridge.md. Kill switch for the whole process (not per community):
# unset = ON; 0 / false / off = paused (commands reject, nothing enqueues,
# the worker sends; queued outbox rows send on re-enable). Read at command
# time, at enqueue, and every worker tick — no restart needed.
# BRIDGE_ENABLED=1
# 32 bytes of base64 (openssl rand -base64 32): AES-256-GCM encryption of
# relay webhook tokens at rest. Required at CONNECT only; create works without
# it. No key rotation in v1 — to change it, disconnect and reconnect bridges.
# BRIDGE_TOKEN_KEY=YOUR_BRIDGE_TOKEN_KEY

# ---------------------------------------------------------------------------
# Fluxer instances (roadmap/fluxer.md, PRs 4-10) — read by the bot at runtime.
# JSON array; one entry per Fluxer instance. instanceKey/origin/token are
# required; clientId+clientSecret enable the web-admin Fluxer sign-in for
# that instance; label is the login-button name (defaults to origin).
# Origins must be https (loopback exempt) unless FLUXER_ALLOW_INSECURE=1.
# Malformed JSON fails boot. See docs/fluxer.md for the full walkthrough.
# FLUXER_INSTANCES=[{"instanceKey":"fluxer.app","origin":"https://fluxer.app","token":"YOUR_FLUXER_BOT_TOKEN","clientId":"YOUR_FLUXER_OAUTH_CLIENT_ID","clientSecret":"YOUR_FLUXER_OAUTH_CLIENT_SECRET","label":"Fluxer.app"}]
# Text-command prefix on Fluxer (1-8 chars, default !). Slash commands are
# Discord-side only.
# FLUXER_COMMAND_PREFIX=!
# Allow http (non-loopback) instance origins for dev/trial. 1 = allow.
# FLUXER_ALLOW_INSECURE=1
# Per-request deadline for ALL Fluxer REST traffic (messages, users, guilds,
# uploads, webhooks). Default 15000 ms, matching discord.js' requestTimeout;
# invalid or out-of-range values fall back to it (no off-switch). A wedged
# instance then surfaces as a named timeout error in seconds instead of
# pinning callers (and gork's per-community queue) at the ~300 s transport
# default (#436).
# FLUXER_REQUEST_TIMEOUT_MS=15000
# Short TTL (ms) of the Fluxer permission fan-out cache (guild/roles/channel
# reads behind prefix commands — successes only; the bot's own channel
# overwrite writes invalidate the entry immediately). 0 disables: every
# command pays the full fan-out (the pre-#385 behavior). Garbage values fall
# back to the default with one complaint (#385).
# FLUXER_PERMISSION_CACHE_MS=5000
